{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "quick-drop",
  "main": "worker.js",
  "compatibility_date": "2026-09-12",

  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  "r2_buckets": [
    {
      "binding": "QUICKDROP",
      "bucket_name": "quick-drop-files"
    }
  ]
}
